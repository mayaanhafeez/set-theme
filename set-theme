# Custom theme files owned by this repository are installed on demand. Themes
# bundled with an app continue to be resolved by that app's normal theme loader.
if [[ -d "$SCRIPT_DIR/themes/$THEME" ]]; then
  [[ -f "$SCRIPT_DIR/themes/$THEME/kitty.conf" ]] && {
    mkdir -p "$HOME/.config/kitty/themes"
    cp "$SCRIPT_DIR/themes/$THEME/kitty.conf" "$HOME/.config/kitty/themes/$KITTY_THEME.conf"
  }
  [[ -f "$SCRIPT_DIR/themes/$THEME/ghostty" ]] && {
    mkdir -p "$HOME/.config/ghostty/themes"
    cp "$SCRIPT_DIR/themes/$THEME/ghostty" "$HOME/.config/ghostty/themes/$GHOSTTY_THEME"
  }
  [[ -f "$SCRIPT_DIR/themes/$THEME/btop.theme" ]] && {
    mkdir -p "$HOME/.config/btop/themes"
    cp "$SCRIPT_DIR/themes/$THEME/btop.theme" "$BTOP_THEME"
  }
  [[ -f "$SCRIPT_DIR/themes/$THEME/sketchybar.lua" ]] && {
    mkdir -p "$HOME/.config/sketchybar/themes"
    cp "$SCRIPT_DIR/themes/$THEME/sketchybar.lua" "$HOME/.config/sketchybar/themes/$SKETCHYBAR_THEME.lua"
  }
  [[ -f "$SCRIPT_DIR/themes/$THEME/neovim.lua" ]] && {
    mkdir -p "$HOME/.config/nvim/lua/set-theme"
    cp "$SCRIPT_DIR/themes/$THEME/neovim.lua" "$HOME/.config/nvim/lua/set-theme/$THEME.lua"
  }
  if [[ -d "$SCRIPT_DIR/themes/$THEME/wallpapers" ]]; then
    mkdir -p "$HOME/Pictures/wallpapers/$THEME"
    cp "$SCRIPT_DIR/themes/$THEME/wallpapers/"* "$HOME/Pictures/wallpapers/$THEME/"
  fi
fi

CUSTOM_KITTY_THEME="$SCRIPT_DIR/themes/$THEME/kitty.conf"

echo "$THEME" > "$THEME_FILE"
echo "Setting theme: $THEME"
echo ""

# ── Kitty ──────────────────────────────────────────────────────────────────────
# Dumps theme colors into current-theme.conf (included by kitty.conf), then
# applies them live via the kitty socket without showing the interactive UI.
echo "→ kitty"
KITTY_THEME_CONF="$HOME/.config/kitty/current-theme.conf"
if [[ -f "$CUSTOM_KITTY_THEME" ]]; then
  cp "$CUSTOM_KITTY_THEME" "$KITTY_THEME_CONF"
  kitty @ --to=unix:/tmp/kitty set-colors --all "$KITTY_THEME_CONF" 2>/dev/null \
    && echo "  applied" \
    || echo "  config updated (kitty not running)"
elif kitty +kitten themes --dump-theme "$KITTY_THEME" > "$KITTY_THEME_CONF" 2>/dev/null; then
  kitty @ --to=unix:/tmp/kitty set-colors --all "$KITTY_THEME_CONF" 2>/dev/null \
    && echo "  applied" \
    || echo "  config updated (kitty not running)"
else
  echo "  theme not found: $KITTY_THEME"
fi

# ── Tmux ───────────────────────────────────────────────────────────────────────
# Tmux uses the terminal's ANSI palette, matching Omarchy's status bar styling.
echo "→ tmux"
TMUX_THEME_CONF="$HOME/.tmux-theme.conf"
cat > "$TMUX_THEME_CONF" <<'EOF'
set -g status-style "bg=default,fg=default"
set -g status-left "#[fg=black,bg=blue,bold] #S #[bg=default] "
set -g status-right "#[fg=blue]#{?pane_in_mode,COPY ,}#{?client_prefix,PREFIX ,}#{?window_zoomed_flag,ZOOM ,}#[fg=brightblack]#h "
set -g window-status-format "#[fg=brightblack] #I:#W "
set -g window-status-current-format "#[fg=blue,bold] #I:#W "
set -g pane-border-style "fg=brightblack"
set -g pane-active-border-style "fg=blue"
set -g message-style "bg=default,fg=blue"
set -g message-command-style "bg=default,fg=blue"
set -g mode-style "bg=blue,fg=black"
setw -g clock-mode-colour blue
EOF
if tmux has-session 2>/dev/null; then
  tmux source-file "$TMUX_THEME_CONF" \
    && echo "  applied" \
    || echo "  config updated (could not reload tmux)"
else
  echo "  config updated (tmux not running)"
fi

# ── Herdr ──────────────────────────────────────────────────────────────────────
echo "→ herdr"
HERDR_CONF="${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}"
if [[ -f "$HERDR_CONF" ]]; then
  awk -v theme="$HERDR_THEME" '
    BEGIN { in_theme = 0; in_custom = 0; updated = 0 }
    /^\[theme\][[:space:]]*$/ { in_theme = 1; print; next }
    /^\[theme\.custom\][[:space:]]*$/ { in_theme = 0; in_custom = 1; next }
    /^\[/ {
      if (in_custom) in_custom = 0
      if (in_theme && !updated) { print "name = \"" theme "\""; updated = 1 }
      in_theme = 0
    }
    in_custom { next }
    in_theme && /^[[:space:]]*name[[:space:]]*=/ {
      print "name = \"" theme "\""
      updated = 1
      next
    }
    { print }
    END { if (in_theme && !updated) print "name = \"" theme "\"" }
  ' "$HERDR_CONF" > "$HERDR_CONF.tmp"
  mv "$HERDR_CONF.tmp" "$HERDR_CONF"
  if command -v herdr >/dev/null 2>&1; then
    herdr server reload-config >/dev/null 2>&1 \
      && echo "  applied" \
      || echo "  config updated (herdr not running)"
  else
    echo "  config updated"
  fi
else
  echo "  skipped (config.toml not found)"
fi

# ── Ghostty ────────────────────────────────────────────────────────────────────
# Ghostty reads config from Application Support on macOS, ~/.config/ghostty on Linux.
# SIGUSR2 triggers a live config reload. `pkill ghostty` cannot find the app on
# macOS — the kernel's process name is the exec path truncated to 16 chars
# ("/Applications/Gh"), which no sensible pattern matches — so pids come from
# ps, matching ucomm exactly.
echo "→ ghostty"
if [[ -d "$HOME/Library/Application Support/com.mitchellh.ghostty" ]]; then
  GHOSTTY_CONF="$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty"
  GHOSTTY_AUTO="$HOME/Library/Application Support/com.mitchellh.ghostty/auto/theme.ghostty"
else
  GHOSTTY_CONF="$HOME/.config/ghostty/config"
  GHOSTTY_AUTO=""
fi
if [[ -f "$GHOSTTY_CONF" ]]; then
  sed -i '' "s/^theme = .*/theme = $GHOSTTY_THEME/" "$GHOSTTY_CONF"
  [[ -n "$GHOSTTY_AUTO" ]] && printf 'theme = %s\n' "$GHOSTTY_THEME" > "$GHOSTTY_AUTO"
  GHOSTTY_PIDS=$(ps ax -o pid=,ucomm= | awk '$2 == "ghostty" { print $1 }')
  GHOSTTY_RELOADED=false
  for GHOSTTY_PID in $GHOSTTY_PIDS; do
    kill -USR2 "$GHOSTTY_PID" 2>/dev/null && GHOSTTY_RELOADED=true
  done
  if [[ "$GHOSTTY_RELOADED" == true ]]; then
    echo "  applied"
  else
    echo "  config updated (ghostty not running)"
  fi
fi

# ── Nvim ───────────────────────────────────────────────────────────────────────
# The nvim config picks its colorscheme the way Omarchy does: on an Omarchy box
# lua/plugins/theme.lua loads whatever Omarchy's current-theme directory holds,
# and `omarchy theme set` owns the choice. Off Omarchy that file falls
# back to its own FALLBACK constant, which is what set-theme rewrites here.
# Live instances are updated through their local RPC sockets.
echo "→ nvim"
NVIM_THEME_FILE="$HOME/.config/nvim/lua/plugins/theme.lua"
if [[ -f "$NVIM_THEME_FILE" ]]; then
  if grep -q "^local FALLBACK = " "$NVIM_THEME_FILE"; then
    sed -i '' "s/^local FALLBACK = \".*\"/local FALLBACK = \"$NVIM_COLORSCHEME\"/" "$NVIM_THEME_FILE"
    if [[ "$THEME" == "rose-pine-dawn" ]] \
      && ! grep -q '^  \["rose-pine-dawn"\] = ' "$NVIM_THEME_FILE"; then
      sed -i '' '/^  \["rose-pine-moon"\] = /i\
  ["rose-pine-dawn"] = { plugin = { "rose-pine/neovim", name = "rose-pine", opts = { variant = "dawn" } } },
' "$NVIM_THEME_FILE"
    fi
    NVIM_PLUGIN=""
    case "$NVIM_COLORSCHEME" in
      rose-pine|rose-pine-dawn|rose-pine-moon) NVIM_PLUGIN="rose-pine" ;;
      tokyonight-night|tokyonight-storm) NVIM_PLUGIN="tokyonight.nvim" ;;
      catppuccin) NVIM_PLUGIN="catppuccin" ;;
      aether) NVIM_PLUGIN="aether.nvim" ;;
      kanagawa) NVIM_PLUGIN="kanagawa.nvim" ;;
      nordfox) NVIM_PLUGIN="nightfox.nvim" ;;
      bamboo) NVIM_PLUGIN="bamboo.nvim" ;;
      retro-82) NVIM_PLUGIN="retro-82.nvim" ;;
      pixel) NVIM_PLUGIN="pixel.nvim" ;;
    esac

    NVIM_APPLIED=false
    NVIM_RUNTIME_DIR="${XDG_RUNTIME_DIR:-${TMPDIR%/}}"
    for NVIM_SERVER in "$NVIM_RUNTIME_DIR"/nvim."$USER"/*/nvim.*; do
      [[ -S "$NVIM_SERVER" ]] || continue
      if nvim --server "$NVIM_SERVER" --remote-expr \
        'luaeval("(function() if _A[1] ~= \"\" then require(\"lazy\").load({plugins = {_A[1]}}) end; vim.cmd.colorscheme(_A[2]); return vim.g.colors_name end)()", ["'"$NVIM_PLUGIN"'", "'"$NVIM_COLORSCHEME"'"])' \
        >/dev/null 2>&1; then
        NVIM_APPLIED=true
      fi
    done

    if [[ "$NVIM_APPLIED" == true ]]; then
      echo "  applied"
    else
      echo "  config updated (restart nvim to apply)"
    fi
  else
    echo "  skipped (no FALLBACK constant in theme.lua)"
  fi
else
  echo "  skipped (theme.lua not found)"
fi

# ── Opencode ───────────────────────────────────────────────────────────────────
# OpenCode's system theme uses terminal ANSI colors, so terminal palette changes
# update the running TUI. The TUI itself must restart once to pick this setting up.
echo "→ opencode"
OPENCODE_CONF="$HOME/.config/opencode/tui.json"
mkdir -p "$(dirname "$OPENCODE_CONF")"
if command -v python3 >/dev/null 2>&1; then
  python3 - "$OPENCODE_CONF" <<'PYEOF'
import json, os, sys
path = sys.argv[1]
if os.path.exists(path):
    with open(path) as f:
        c = json.load(f)
else:
    c = {"$schema": "https://opencode.ai/tui.json"}
c['theme'] = 'system'
with open(path, 'w') as f:
    json.dump(c, f, indent=2)
    f.write('\n')
PYEOF
  echo "  configured system theme (restart opencode once to apply)"
fi

# ── Macwifi ────────────────────────────────────────────────────────────────────
echo "→ macwifi"
MACWIFI_CONF="$HOME/Library/Application Support/macwifi/config.toml"
if [[ -f "$MACWIFI_CONF" ]]; then
  if grep -q '^theme = ' "$MACWIFI_CONF"; then
    sed -i '' "s/^theme = .*/theme = \"$MACWIFI_THEME\"/" "$MACWIFI_CONF"
  else
    echo "theme = \"$MACWIFI_THEME\"" >> "$MACWIFI_CONF"
  fi
  echo "  updated"
fi

# ── Google Chrome ─────────────────────────────────────────────────────────────
# Chrome cannot reload its browser chrome from an external script. Queue its
# native custom-color theme while Chrome is open; the sibling helper waits for
# every Chrome process to exit, writes the latest queued color, and leaves
# relaunch timing entirely to the user. If Chrome is closed, it applies now.
echo "→ chrome"
CHROME_THEME_SCRIPT="$SCRIPT_DIR/chrome-theme"
if [[ ! -x "$CHROME_THEME_SCRIPT" ]]; then
  echo "  skipped (chrome-theme helper not found)"
else
  CHROME_ACCENT="#${BORDERS_COLOR:4}"
  echo "  $($CHROME_THEME_SCRIPT "$CHROME_ACCENT")"
fi

# ── OpenLogi ───────────────────────────────────────────────────────────────────
# OpenLogi picks its UI theme by display name. Set the slot matching the theme's
# appearance and switch the app to that appearance.
# The app reads config.toml at launch and rewrites the whole file when it saves
# a setting, so it must be restarted to pick this up, and a setting changed in
# a running OpenLogi can overwrite this edit.
echo "→ openlogi"
# Install the custom theme JSON owned by this switcher. All others map to a
# built-in OpenLogi theme by display name, so no file is dropped in.
case "$THEME" in
  drive|archriot|blueridge-dark|dark-xp|kitsune|last-horizon|rose-pine-dawn)
    if [[ -f "$SCRIPT_DIR/openlogi/$THEME.json" ]]; then
      for profile in openlogi openlogi-dev; do
        mkdir -p "$HOME/.config/$profile/themes"
        cp "$SCRIPT_DIR/openlogi/$THEME.json" "$HOME/.config/$profile/themes/$THEME.json"
      done
    fi
    ;;
esac
OPENLOGI_CONF="$HOME/.config/openlogi/config.toml"
if [[ -f "$OPENLOGI_CONF" ]]; then
  OPENLOGI_THEME_KEY="theme_$APPEARANCE"
  if grep -q "^$OPENLOGI_THEME_KEY = " "$OPENLOGI_CONF"; then
    sed -i '' "s/^$OPENLOGI_THEME_KEY = .*/$OPENLOGI_THEME_KEY = \"$OPENLOGI_THEME\"/" "$OPENLOGI_CONF"
  elif grep -q '^\[app_settings\]' "$OPENLOGI_CONF"; then
    # Add the key inside [app_settings]; appending to the file would land it in
    # whichever table happens to come last. cat back over the original rather
    # than mv so the config keeps its 0600 permissions.
    awk -v key="$OPENLOGI_THEME_KEY" -v theme="$OPENLOGI_THEME" '
      BEGIN { in_app = 0; added = 0 }
      /^\[app_settings\][[:space:]]*$/ { in_app = 1; print; next }
      /^\[/ {
        if (in_app && !added) { print key " = \"" theme "\""; added = 1 }
        in_app = 0
      }
      { print }
      END { if (in_app && !added) print key " = \"" theme "\"" }
    ' "$OPENLOGI_CONF" > "$OPENLOGI_CONF.tmp"
    cat "$OPENLOGI_CONF.tmp" > "$OPENLOGI_CONF"
    rm -f "$OPENLOGI_CONF.tmp"
  else
    printf '\n[app_settings]\n%s = "%s"\n' "$OPENLOGI_THEME_KEY" "$OPENLOGI_THEME" >> "$OPENLOGI_CONF"
  fi
  if grep -q '^appearance = ' "$OPENLOGI_CONF"; then
    sed -i '' "s/^appearance = .*/appearance = \"$APPEARANCE\"/" "$OPENLOGI_CONF"
  fi
  if pgrep -x openlogi-gui >/dev/null 2>&1; then
    echo "  config updated (quit and reopen OpenLogi to apply)"
  else
    echo "  config updated"
  fi
else
  echo "  skipped (config.toml not found)"
fi

# ── Appearance (macOS) ─────────────────────────────────────────────────────────
echo "→ appearance"
if [[ "$APPEARANCE" == "light" ]]; then
  osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to false' \
    && echo "  applied light" \
    || echo "  failed to set light"
else
  osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to true' \
    && echo "  applied dark" \
    || echo "  failed to set dark"
fi

# ── Btop ───────────────────────────────────────────────────────────────────────
# SIGUSR2 reloads btop's config file. Community themes live in ~/.config/btop/themes/.
echo "→ btop"
BTOP_CONF="$HOME/.config/btop/btop.conf"
if [[ -f "$BTOP_CONF" ]]; then
  sed -i '' "s|^color_theme = .*|color_theme = \"$BTOP_THEME\"|" "$BTOP_CONF"
  pkill -SIGUSR2 btop 2>/dev/null \
    && echo "  applied" \
    || echo "  config updated (btop not running)"
fi

# ── SketchyBar ─────────────────────────────────────────────────────────────────
echo "→ sketchybar"
SKETCHYBAR_SETTINGS="$HOME/.config/sketchybar/settings.lua"
if [[ -f "$SKETCHYBAR_SETTINGS" ]]; then
  sed -i '' "s/theme = \".*\",/theme = \"$SKETCHYBAR_THEME\",/" "$SKETCHYBAR_SETTINGS"
  sketchybar --reload 2>/dev/null \
    && echo "  applied" \
    || echo "  config updated (sketchybar not running)"
fi

# ── Borders (JankyBorders) ─────────────────────────────────────────────────────
# Only the active-window border is themed; width/style/inactive stay as configured.
# Re-invoking the borders binary hands the new options to the running instance.
echo "→ borders"
BORDERS_CONF="$HOME/.config/borders/bordersrc"
if [[ -f "$BORDERS_CONF" ]]; then
  sed -i '' "s/^\([[:space:]]*\)active_color=.*/\1active_color=$BORDERS_COLOR/" "$BORDERS_CONF"
  if command -v borders >/dev/null 2>&1 && pgrep -x borders >/dev/null 2>&1; then
    borders active_color="$BORDERS_COLOR" >/dev/null 2>&1 \
      && echo "  applied" \
      || echo "  config updated (could not reach borders)"
  else
    echo "  config updated (borders not running)"
  fi
fi

# ── Accent color (macOS) ───────────────────────────────────────────────────────
# The sibling `accent` script writes AppleAccentColor/AppleHighlightColor and
# nudges the system to reload them. macOS only offers eight accents, so each
# theme maps to the nearest one (see ACCENT_COLOR above). Apps read the accent
# when they launch, so already-open windows keep the old tint until relaunched.
echo "→ accent"
ACCENT_SCRIPT="$SCRIPT_DIR/accent"
if [[ -x "$ACCENT_SCRIPT" ]]; then
  if "$ACCENT_SCRIPT" "$ACCENT_COLOR" >/dev/null 2>&1; then
    echo "  applied $ACCENT_COLOR"
  else
    echo "  failed to set $ACCENT_COLOR"
  fi
else
  echo "  skipped (accent script not found)"
fi

# ── Wallpaper ──────────────────────────────────────────────────────────────────
# Each theme has a matching wallpaper set in ~/Pictures/wallpapers/<theme>/.
# One is picked at random and handed to the set-wallpaper script.
echo "→ wallpaper"
WALLPAPER_DIR="$HOME/Pictures/wallpapers/$THEME"
if ! command -v set-wallpaper >/dev/null 2>&1; then
  echo "  skipped (set-wallpaper not found)"
elif [[ ! -d "$WALLPAPER_DIR" ]]; then
  echo "  skipped (no wallpapers for $THEME)"
else
  WALLPAPERS=()
  while IFS= read -r -d '' f; do
    WALLPAPERS+=("$f")
  done < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.heic' \
       -o -iname '*.tif' -o -iname '*.tiff' -o -iname '*.gif' \) -print0)

  if [[ ${#WALLPAPERS[@]} -eq 0 ]]; then
    echo "  skipped (no images in $WALLPAPER_DIR)"
  else
    WALLPAPER="${WALLPAPERS[RANDOM % ${#WALLPAPERS[@]}]}"
    if set-wallpaper "$WALLPAPER" >/dev/null 2>&1; then
      echo "  applied ${WALLPAPER##*/}"
    else
      echo "  failed to set ${WALLPAPER##*/}"
    fi
  fi
fi

echo ""
echo "Done. Active theme: $THEME"
