#!/usr/bin/env bash
# set-theme — unified theme switcher for kitty, ghostty, tmux, herdr, nvim,
# opencode, macwifi, openlogi, btop, sketchybar, borders (JankyBorders), the
# macOS appearance/accent color and the desktop wallpaper
#
# Usage:
#   set-theme <theme>        apply theme and save it (name is fuzzy-matched,
#                            e.g. "catppuccin", "rosepine", or a typo all resolve)
#   set-theme demo           cycle through every theme, pausing after each applies
#   set-theme                list available themes (marks the active one)
#
# Active theme is persisted in ~/.config/theme.
#
# To add a new theme, add it to THEMES below, add a matching case block, and
# define all variables. Themes must also exist in each app's own config
# (e.g. a sketchybar themes/*.lua file).

set -euo pipefail

THEME_FILE="$HOME/.config/theme"

# Directory holding this script, with symlinks resolved (it is usually invoked
# through a symlink in ~/.local/bin). Sibling scripts like `accent` live here.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  LINK=$(readlink "$SELF")
  [[ "$LINK" == /* ]] && SELF="$LINK" || SELF="$(dirname "$SELF")/$LINK"
done
SCRIPT_DIR=$(cd "$(dirname "$SELF")" && pwd)

# Available themes, in display order.
THEMES=(andromeda archriot blueridge-dark catppuccin-mocha dark-xp drive hinterlands kanagawa kitsune last-horizon matte-black nord osaka-jade retro-82 ristretto rose-pine rose-pine-dawn rose-pine-moon tokyo-night tokyo-night-storm tomorrow-night-burns vanta-black)
DEMO_DELAY=5

list_themes() {
  local current=""
  [[ -f "$THEME_FILE" ]] && current=$(tr -d '[:space:]' < "$THEME_FILE")
  echo "Available themes:"
  local t
  for t in "${THEMES[@]}"; do
    if [[ "$t" == "$current" ]]; then
      echo "  * $t (active)"
    else
      echo "    $t"
    fi
  done
}

# Resolve a (possibly partial/misspelled) input to a canonical theme name.
# Prints the match and returns 0, or returns 1 if nothing matches.
#   1. case-insensitive exact match
#   2. fzf fuzzy match (handles partials like "catppuccin" and typos)
#   3. hyphen/space-insensitive substring match (fallback when fzf is absent)
resolve_input() {
  local input q t match=""
  input="$1"
  q=$(printf '%s' "$input" | tr '[:upper:]' '[:lower:]')

  for t in "${THEMES[@]}"; do
    [[ "$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]')" == "$q" ]] && { printf '%s\n' "$t"; return 0; }
  done

  if command -v fzf >/dev/null 2>&1; then
    match=$(printf '%s\n' "${THEMES[@]}" | fzf --filter="$q" 2>/dev/null | head -n1 || true)
  fi

  if [[ -z "$match" ]]; then
    local nin nt
    nin=$(printf '%s' "$q" | tr -cd '[:alnum:]')
    for t in "${THEMES[@]}"; do
      nt=$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]')
      if [[ -n "$nin" && "$nt" == *"$nin"* ]]; then match="$t"; break; fi
    done
  fi

  [[ -n "$match" ]] && { printf '%s\n' "$match"; return 0; }
  return 1
}

THEME="${1:-}"
IS_DEMO="${IS_DEMO:-false}"
if [[ -z "$THEME" ]]; then
  list_themes
  exit 0
fi

if [[ "$THEME" == "demo" ]]; then
  ORIGINAL_THEME=""
  [[ -f "$THEME_FILE" ]] && ORIGINAL_THEME=$(tr -d '[:space:]' < "$THEME_FILE")

  # Remember the current wallpaper so the demo's random picks can be undone.
  ORIGINAL_WALLPAPER=$(osascript -e \
    'tell application "System Events" to tell current desktop to get picture' 2>/dev/null || true)

  for theme in "${THEMES[@]}"; do
    IS_DEMO=true "$0" "$theme"
    echo "Showing $theme for ${DEMO_DELAY}s..."
    sleep "$DEMO_DELAY"
  done

  if [[ -n "$ORIGINAL_THEME" ]]; then
    IS_DEMO=true "$0" "$ORIGINAL_THEME"
    echo "Restored theme: $ORIGINAL_THEME"
  fi

  # Undo the wallpaper the restored theme just picked at random. macOS applies
  # wallpaper changes asynchronously, so back-to-back sets can settle out of
  # order — wait for the last one to land, then set and verify, retrying.
  if [[ -n "$ORIGINAL_WALLPAPER" && -f "$ORIGINAL_WALLPAPER" ]] \
    && command -v set-wallpaper >/dev/null 2>&1; then
    sleep 2
    for _ in 1 2 3; do
      set-wallpaper "$ORIGINAL_WALLPAPER" >/dev/null 2>&1 || true
      sleep 2
      CURRENT_WALLPAPER=$(osascript -e \
        'tell application "System Events" to tell current desktop to get picture' 2>/dev/null || true)
      [[ "$CURRENT_WALLPAPER" == "$ORIGINAL_WALLPAPER" ]] && break
    done
    if [[ "${CURRENT_WALLPAPER:-}" == "$ORIGINAL_WALLPAPER" ]]; then
      echo "Restored wallpaper: ${ORIGINAL_WALLPAPER##*/}"
    else
      echo "Could not restore wallpaper: ${ORIGINAL_WALLPAPER##*/}"
    fi
  fi
  exit 0
fi

# Fuzzy-resolve the requested name to a canonical theme.
RESOLVED=$(resolve_input "$THEME") || {
  echo "No theme matches: $THEME"
  list_themes
  exit 1
}
if [[ "$RESOLVED" != "$THEME" ]]; then
  echo "Matched \"$THEME\" → $RESOLVED"
fi
THEME="$RESOLVED"
if [[ "$IS_DEMO" != true ]]; then
  if [[ -d "$HOME/set-theme" ]]; then
    echo "$THEME" > "$HOME/set-theme/current_theme"
  fi
fi
# ── Theme definitions ──────────────────────────────────────────────────────────
