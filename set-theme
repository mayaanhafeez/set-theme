#!/usr/bin/env bash
# set-theme — unified theme switcher for kitty, ghostty, nvim, opencode, macwifi,
# btop, sketchybar and borders (JankyBorders)
#
# Usage:
#   set-theme <theme>        apply theme and save it (name is fuzzy-matched,
#                            e.g. "catppuccin", "rosepine", or a typo all resolve)
#   set-theme demo           cycle through every theme, pausing after each applies
#   set-theme                list available themes (marks the active one)
#
# Active theme is persisted in ~/.config/theme.
#
# To add a new theme, add it to THEMES below, add a matching case block, and
# define all variables. Themes must also exist in each app's own config
# (e.g. a sketchybar themes/*.lua file).

set -euo pipefail

THEME_FILE="$HOME/.config/theme"

# Available themes, in display order.
THEMES=(andromeda catppuccin-mocha hinterlands matte-black rose-pine rose-pine-moon tokyo-night tokyo-night-storm tomorrow-night-burns vanta-black)
DEMO_DELAY=5

list_themes() {
  local current=""
  [[ -f "$THEME_FILE" ]] && current=$(tr -d '[:space:]' < "$THEME_FILE")
  echo "Available themes:"
  local t
  for t in "${THEMES[@]}"; do
    if [[ "$t" == "$current" ]]; then
      echo "  * $t (active)"
    else
      echo "    $t"
    fi
  done
}

# Resolve a (possibly partial/misspelled) input to a canonical theme name.
# Prints the match and returns 0, or returns 1 if nothing matches.
#   1. case-insensitive exact match
#   2. fzf fuzzy match (handles partials like "catppuccin" and typos)
#   3. hyphen/space-insensitive substring match (fallback when fzf is absent)
resolve_input() {
  local input q t match=""
  input="$1"
  q=$(printf '%s' "$input" | tr '[:upper:]' '[:lower:]')

  for t in "${THEMES[@]}"; do
    [[ "$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]')" == "$q" ]] && { printf '%s\n' "$t"; return 0; }
  done

  if command -v fzf >/dev/null 2>&1; then
    match=$(printf '%s\n' "${THEMES[@]}" | fzf --filter="$q" 2>/dev/null | head -n1 || true)
  fi

  if [[ -z "$match" ]]; then
    local nin nt
    nin=$(printf '%s' "$q" | tr -cd '[:alnum:]')
    for t in "${THEMES[@]}"; do
      nt=$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]')
      if [[ -n "$nin" && "$nt" == *"$nin"* ]]; then match="$t"; break; fi
    done
  fi

  [[ -n "$match" ]] && { printf '%s\n' "$match"; return 0; }
  return 1
}

THEME="${1:-}"
if [[ -z "$THEME" ]]; then
  list_themes
  exit 0
fi

if [[ "$THEME" == "demo" ]]; then
  ORIGINAL_THEME=""
  [[ -f "$THEME_FILE" ]] && ORIGINAL_THEME=$(tr -d '[:space:]' < "$THEME_FILE")

  for theme in "${THEMES[@]}"; do
    "$0" "$theme"
    echo "Showing $theme for ${DEMO_DELAY}s..."
    sleep "$DEMO_DELAY"
  done

  if [[ -n "$ORIGINAL_THEME" ]]; then
    "$0" "$ORIGINAL_THEME"
    echo "Restored theme: $ORIGINAL_THEME"
  fi
  exit 0
fi

# Fuzzy-resolve the requested name to a canonical theme.
RESOLVED=$(resolve_input "$THEME") || {
  echo "No theme matches: $THEME"
  list_themes
  exit 1
}
if [[ "$RESOLVED" != "$THEME" ]]; then
  echo "Matched \"$THEME\" → $RESOLVED"
fi
THEME="$RESOLVED"

# ── Theme definitions ──────────────────────────────────────────────────────────
# NVIM_COLORSCHEME must be a key of `local_themes` in the nvim config's
# lua/plugins/theme.lua, which is what decides whether a plugin is needed.
# btop ships no catppuccin/rose-pine themes; closest built-ins are used instead.
# BORDERS_COLOR is the JankyBorders active-window border, as 0xAARRGGBB.

case "$THEME" in
  andromeda)
    # An Omarchy theme (github.com/signaldirective/andromeda): deep blue-grey with
    # vivid teal/pink/purple accents. Ghostty ships it; the kitty, nvim, opencode,
    # btop and sketchybar themes are ported from the repo's colors.toml.
    # macwifi has no matching theme, so its closest built-in is used.
    KITTY_THEME="Andromeda"
    GHOSTTY_THEME="Andromeda"
    NVIM_COLORSCHEME="andromeda"
    OPENCODE_THEME="andromeda"
    MACWIFI_THEME="dracula"
    SKETCHYBAR_THEME="andromeda"
    BTOP_THEME="$HOME/.config/btop/themes/andromeda.theme"
    BORDERS_COLOR="0xff00e8c6"  # teal
    ;;
  catppuccin-mocha)
    KITTY_THEME="Catppuccin-Mocha"
    GHOSTTY_THEME="Catppuccin Mocha"
    NVIM_COLORSCHEME="catppuccin"
    OPENCODE_THEME="catppuccin"
    MACWIFI_THEME="catppuccin-mocha"
    SKETCHYBAR_THEME="catppuccin_mocha"
    BTOP_THEME="$HOME/.config/btop/themes/catppuccin_mocha.theme"
    BORDERS_COLOR="0xff89b4fa"  # blue
    ;;
  hinterlands)
    # An Omarchy theme (github.com/OldJobobo/omarchy-hinterlands-theme): monochrome
    # greys with crisp white highlights. Nothing ships it, so the kitty, ghostty,
    # opencode, btop and sketchybar themes are all ported from the repo's
    # colors.toml. nvim uses aether.nvim, the plugin the repo's neovim.lua calls for.
    # macwifi has no monochrome theme; nord is the closest built-in.
    KITTY_THEME="Hinterlands"
    GHOSTTY_THEME="Hinterlands"
    NVIM_COLORSCHEME="aether"
    OPENCODE_THEME="hinterlands"
    MACWIFI_THEME="nord"
    SKETCHYBAR_THEME="hinterlands"
    BTOP_THEME="$HOME/.config/btop/themes/hinterlands.theme"
    BORDERS_COLOR="0xffb9b9b9"  # light grey
    ;;
  matte-black)
    # An official Omarchy theme (basecamp/omarchy, themes/matte-black): near-black
    # with amber and burnt-red accents. Ghostty ships it; the kitty, nvim, opencode,
    # btop and sketchybar themes are ported from the repo's colors.toml.
    # macwifi has no matching theme, so its closest built-in is used.
    KITTY_THEME="Matte Black"
    GHOSTTY_THEME="Matte Black"
    NVIM_COLORSCHEME="matte-black"
    OPENCODE_THEME="matte-black"
    MACWIFI_THEME="gruvbox-dark"
    SKETCHYBAR_THEME="matte_black"
    BTOP_THEME="$HOME/.config/btop/themes/matte_black.theme"
    BORDERS_COLOR="0xffe68e0d"  # amber
    ;;
  rose-pine)
    KITTY_THEME="Rosé Pine"
    GHOSTTY_THEME="Rose Pine"
    NVIM_COLORSCHEME="rose-pine"
    OPENCODE_THEME="rosepine"
    MACWIFI_THEME="rose-pine"
    SKETCHYBAR_THEME="rose_pine"
    BTOP_THEME="$HOME/.config/btop/themes/rose_pine.theme"
    BORDERS_COLOR="0xff5fcfc9"  # teal
    ;;
  rose-pine-moon)
    KITTY_THEME="Rosé Pine Moon"
    GHOSTTY_THEME="Rose Pine Moon"
    NVIM_COLORSCHEME="rose-pine-moon"
    OPENCODE_THEME="rosepine-moon"
    MACWIFI_THEME="rose-pine-moon"
    SKETCHYBAR_THEME="rose_pine_moon"
    BTOP_THEME="$HOME/.config/btop/themes/rose_pine_moon.theme"
    BORDERS_COLOR="0xff5fcfc9"  # teal
    ;;
  tokyo-night)
    KITTY_THEME="Tokyo Night"
    GHOSTTY_THEME="TokyoNight Night"
    NVIM_COLORSCHEME="tokyonight-night"
    OPENCODE_THEME="tokyonight"
    MACWIFI_THEME="tokyo-night"
    SKETCHYBAR_THEME="tokyo_night"
    BTOP_THEME="$HOME/.config/btop/themes/tokyo_night.theme"
    BORDERS_COLOR="0xff7aa2f7"  # blue
    ;;
  tokyo-night-storm)
    KITTY_THEME="Tokyo Night Storm"
    GHOSTTY_THEME="TokyoNight Storm"
    NVIM_COLORSCHEME="tokyonight-storm"
    OPENCODE_THEME="tokyonight-storm"
    MACWIFI_THEME="tokyo-night-storm"
    SKETCHYBAR_THEME="tokyo_night_storm"
    BTOP_THEME="$HOME/.config/btop/themes/tokyo_night_storm.theme"
    BORDERS_COLOR="0xff5fcfc9"  # teal
    ;;
  tomorrow-night-burns)
    # A monochromatic dark-red theme. Ghostty ships it and nvim has a local
    # colors/tomorrow-night-burns.lua; the kitty, opencode, btop and sketchybar
    # themes are hand-written to match. macwifi has no matching (or custom) theme,
    # so its closest built-in is used.
    KITTY_THEME="Tomorrow Night Burns"
    GHOSTTY_THEME="Tomorrow Night Burns"
    NVIM_COLORSCHEME="tomorrow-night-burns"
    OPENCODE_THEME="tomorrow-night-burns"
    MACWIFI_THEME="dracula"
    SKETCHYBAR_THEME="tomorrow_night_burns"
    BTOP_THEME="$HOME/.config/btop/themes/tomorrow_night_burns.theme"
    BORDERS_COLOR="0xfffc595f"  # bright red
    ;;
  vanta-black)
    # A pure-black monochrome theme: #000000 background, every accent a grey.
    # Nothing ships it, so the kitty, ghostty, nvim, opencode, btop and sketchybar
    # themes are all written from the supplied palette. macwifi has no monochrome
    # theme; "default" is used since it is the only one that imposes no hue.
    KITTY_THEME="Vanta Black"
    GHOSTTY_THEME="Vanta Black"
    NVIM_COLORSCHEME="vanta-black"
    OPENCODE_THEME="vanta-black"
    MACWIFI_THEME="default"
    SKETCHYBAR_THEME="vanta_black"
    BTOP_THEME="$HOME/.config/btop/themes/vanta_black.theme"
    BORDERS_COLOR="0xff8d8d8d"  # accent grey
    ;;
  *)
    echo "Unknown theme: $THEME"
    list_themes
    exit 1
    ;;
esac

echo "$THEME" > "$THEME_FILE"
echo "Setting theme: $THEME"
echo ""

# ── Kitty ──────────────────────────────────────────────────────────────────────
# Dumps theme colors into current-theme.conf (included by kitty.conf), then
# applies them live via the kitty socket without showing the interactive UI.
echo "→ kitty"
KITTY_THEME_CONF="$HOME/.config/kitty/current-theme.conf"
if kitty +kitten themes --dump-theme "$KITTY_THEME" > "$KITTY_THEME_CONF" 2>/dev/null; then
  kitty @ --to=unix:/tmp/kitty set-colors --all "$KITTY_THEME_CONF" 2>/dev/null \
    && echo "  applied" \
    || echo "  config updated (kitty not running)"
else
  echo "  theme not found: $KITTY_THEME"
fi

# ── Ghostty ────────────────────────────────────────────────────────────────────
# Ghostty reads config from Application Support on macOS, ~/.config/ghostty on Linux.
# SIGUSR2 triggers a live config reload.
echo "→ ghostty"
if [[ -d "$HOME/Library/Application Support/com.mitchellh.ghostty" ]]; then
  GHOSTTY_CONF="$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty"
  GHOSTTY_AUTO="$HOME/Library/Application Support/com.mitchellh.ghostty/auto/theme.ghostty"
else
  GHOSTTY_CONF="$HOME/.config/ghostty/config"
  GHOSTTY_AUTO=""
fi
if [[ -f "$GHOSTTY_CONF" ]]; then
  sed -i '' "s/^theme = .*/theme = $GHOSTTY_THEME/" "$GHOSTTY_CONF"
  [[ -n "$GHOSTTY_AUTO" ]] && printf 'theme = %s\n' "$GHOSTTY_THEME" > "$GHOSTTY_AUTO"
  pkill -SIGUSR2 ghostty 2>/dev/null \
    && echo "  applied" \
    || echo "  config updated (ghostty not running)"
fi

# ── Nvim ───────────────────────────────────────────────────────────────────────
# The nvim config picks its colorscheme the way Omarchy does: on an Omarchy box
# lua/plugins/theme.lua loads whatever Omarchy's current-theme directory holds,
# and `omarchy theme set` owns the choice. Off Omarchy that file falls
# back to its own FALLBACK constant, which is what set-theme rewrites here.
# Live instances are updated through their local RPC sockets.
echo "→ nvim"
NVIM_THEME_FILE="$HOME/.config/nvim/lua/plugins/theme.lua"
if [[ -f "$NVIM_THEME_FILE" ]]; then
  if grep -q "^local FALLBACK = " "$NVIM_THEME_FILE"; then
    sed -i '' "s/^local FALLBACK = \".*\"/local FALLBACK = \"$NVIM_COLORSCHEME\"/" "$NVIM_THEME_FILE"
    NVIM_PLUGIN=""
    case "$NVIM_COLORSCHEME" in
      rose-pine|rose-pine-moon) NVIM_PLUGIN="rose-pine" ;;
      tokyonight-night|tokyonight-storm) NVIM_PLUGIN="tokyonight.nvim" ;;
      catppuccin) NVIM_PLUGIN="catppuccin" ;;
      aether) NVIM_PLUGIN="aether.nvim" ;;
    esac

    NVIM_APPLIED=false
    NVIM_RUNTIME_DIR="${XDG_RUNTIME_DIR:-${TMPDIR%/}}"
    for NVIM_SERVER in "$NVIM_RUNTIME_DIR"/nvim."$USER"/*/nvim.*; do
      [[ -S "$NVIM_SERVER" ]] || continue
      if nvim --server "$NVIM_SERVER" --remote-expr \
        'luaeval("(function() if _A[1] ~= \"\" then require(\"lazy\").load({plugins = {_A[1]}}) end; vim.cmd.colorscheme(_A[2]); return vim.g.colors_name end)()", ["'"$NVIM_PLUGIN"'", "'"$NVIM_COLORSCHEME"'"])' \
        >/dev/null 2>&1; then
        NVIM_APPLIED=true
      fi
    done

    if [[ "$NVIM_APPLIED" == true ]]; then
      echo "  applied"
    else
      echo "  config updated (restart nvim to apply)"
    fi
  else
    echo "  skipped (no FALLBACK constant in theme.lua)"
  fi
else
  echo "  skipped (theme.lua not found)"
fi

# ── Opencode ───────────────────────────────────────────────────────────────────
# OpenCode's system theme uses terminal ANSI colors, so terminal palette changes
# update the running TUI. The TUI itself must restart once to pick this setting up.
echo "→ opencode"
OPENCODE_CONF="$HOME/.config/opencode/tui.json"
mkdir -p "$(dirname "$OPENCODE_CONF")"
if command -v python3 >/dev/null 2>&1; then
  python3 - "$OPENCODE_CONF" <<'PYEOF'
import json, os, sys
path = sys.argv[1]
if os.path.exists(path):
    with open(path) as f:
        c = json.load(f)
else:
    c = {"$schema": "https://opencode.ai/tui.json"}
c['theme'] = 'system'
with open(path, 'w') as f:
    json.dump(c, f, indent=2)
    f.write('\n')
PYEOF
  echo "  configured system theme (restart opencode once to apply)"
fi

# ── Macwifi ────────────────────────────────────────────────────────────────────
echo "→ macwifi"
MACWIFI_CONF="$HOME/Library/Application Support/macwifi/config.toml"
if [[ -f "$MACWIFI_CONF" ]]; then
  if grep -q '^theme = ' "$MACWIFI_CONF"; then
    sed -i '' "s/^theme = .*/theme = \"$MACWIFI_THEME\"/" "$MACWIFI_CONF"
  else
    echo "theme = \"$MACWIFI_THEME\"" >> "$MACWIFI_CONF"
  fi
  echo "  updated"
fi

# ── Btop ───────────────────────────────────────────────────────────────────────
# SIGUSR2 reloads btop's config file. Community themes live in ~/.config/btop/themes/.
echo "→ btop"
BTOP_CONF="$HOME/.config/btop/btop.conf"
if [[ -f "$BTOP_CONF" ]]; then
  sed -i '' "s|^color_theme = .*|color_theme = \"$BTOP_THEME\"|" "$BTOP_CONF"
  pkill -SIGUSR2 btop 2>/dev/null \
    && echo "  applied" \
    || echo "  config updated (btop not running)"
fi

# ── SketchyBar ─────────────────────────────────────────────────────────────────
echo "→ sketchybar"
SKETCHYBAR_SETTINGS="$HOME/.config/sketchybar/settings.lua"
if [[ -f "$SKETCHYBAR_SETTINGS" ]]; then
  sed -i '' "s/theme = \".*\",/theme = \"$SKETCHYBAR_THEME\",/" "$SKETCHYBAR_SETTINGS"
  sketchybar --reload 2>/dev/null \
    && echo "  applied" \
    || echo "  config updated (sketchybar not running)"
fi

# ── Borders (JankyBorders) ─────────────────────────────────────────────────────
# Only the active-window border is themed; width/style/inactive stay as configured.
# Re-invoking the borders binary hands the new options to the running instance.
echo "→ borders"
BORDERS_CONF="$HOME/.config/borders/bordersrc"
if [[ -f "$BORDERS_CONF" ]]; then
  sed -i '' "s/^\([[:space:]]*\)active_color=.*/\1active_color=$BORDERS_COLOR/" "$BORDERS_CONF"
  if command -v borders >/dev/null 2>&1 && pgrep -x borders >/dev/null 2>&1; then
    borders active_color="$BORDERS_COLOR" >/dev/null 2>&1 \
      && echo "  applied" \
      || echo "  config updated (could not reach borders)"
  else
    echo "  config updated (borders not running)"
  fi
fi

echo ""
echo "Done. Active theme: $THEME"
